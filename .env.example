# Copy this file to .env and paste your free key from https://aistudio.google.com
GEMINI_API_KEY=
# Optional: which Gemini model to use (the app tries a few if this one is unavailable)
GEMINI_MODEL=gemini-3.5-flash-lite
# Keep "My letters" between visits on this computer (leave unset on a public server)
PLAINSPEAK_LOCAL=1
